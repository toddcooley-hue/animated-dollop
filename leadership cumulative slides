# ---- Helpers ----
term_to_fy <- function(term_chr) {
  yr <- str_extract(term_chr %||% "", "\\b\\d{4}\\b")
  suppressWarnings(as.integer(yr))
}

# ---- Null coalesce helper (so %||% calls don't error) ----
`%||%` <- function(x, y) {
  if (is.null(x) || length(x) == 0) y else x
}


program_group_major <- function(major) {
  m <- tolower(trimws(ifelse(is.na(major), "", major)))
  
  noncredit_titles <- c("Essential Grant Writing",
                        "Project Management Certificate",
                        "DEIB Professional Certificate")
  
  is_grad          <- str_detect(m, "master") | str_detect(m, "graduate certificate")
  is_accel         <- str_detect(m, "accelerated")
  is_non_degree    <- str_detect(m, "\\bnon\\s*-?degree\\b")
  is_noncredit_any <- Reduce(`|`, lapply(noncredit_titles, function(t) str_detect(m, fixed(t, ignore_case = TRUE))), init = FALSE)
  
  is_pm_standalone <- str_detect(m, "project management") &
    !str_detect(m, "accelerated") &
    !str_detect(m, "bachelor") &
    !str_detect(m, "certificate")
  
  dplyr::case_when(
    is_grad ~ "Graduate programs (all)",
    is_accel ~ "Accelerated Degree Completion (all concentrations)",
    is_non_degree | is_noncredit_any | is_pm_standalone ~ "Non-credit",
    TRUE ~ "Continuing Studies"
  )
}

# --- REPLACE your parse_any_date() with this ---
parse_any_date <- function(x) {
  # Fast paths: already Date/POSIXt/numeric (Excel)
  if (inherits(x, "Date"))    return(x)
  if (inherits(x, c("POSIXct","POSIXt"))) return(as.Date(x))
  if (is.numeric(x)) return(as.Date(as.numeric(x), origin = "1899-12-30"))
  
  # Character path (handles ISO8601 with offsets, ymd, mdy)
  x_chr <- trimws(as.character(x))
  x_chr[x_chr == ""] <- NA_character_
  
  d <- suppressWarnings(coalesce(
    readr::parse_datetime(x_chr, locale = readr::locale(tz = "UTC")), # very tolerant RFC3339/ISO8601
    ymd_hms(x_chr, quiet = TRUE, tz = "UTC"),
    ymd(x_chr),
    mdy(x_chr)
  ))
  as.Date(d)
}


# ---- Stage column resolver (handles duplicates like "Date of Inquiry...7") ----
pick_date_col <- function(df, base) {
  if (base %in% names(df)) return(base)
  cands <- names(df)[str_detect(names(df), paste0("^", fixed(base)))]
  if (length(cands)) return(cands[1])
  stop("Missing expected column starting with '", base, "'.")
  
  
}

