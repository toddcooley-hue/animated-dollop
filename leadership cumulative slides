# ---------- Conversion rates (FY<curr> + Δpp vs FY<prev>) ----------
safe_div <- function(num, den) ifelse(den == 0, NA_real_, num / den)
getv <- function(stage, fy) {
  nm <- paste0(stage, "_", fy)
  if (!nm %in% names(wide)) return(rep(0, nrow(wide)))
  wide[[nm]]
}

build_rates <- function(curr_fy, prev_fy) {
  S_cur <- getv("Suspects",     curr_fy); S_prv <- getv("Suspects",     prev_fy)
  P_cur <- getv("Prospects",    curr_fy); P_prv <- getv("Prospects",    prev_fy)
  A_cur <- getv("Applications", curr_fy); A_prv <- getv("Applications", prev_fy)  # <-- submits
  Adm_cur <- getv("Admits",     curr_fy); Adm_prv <- getv("Admits",     prev_fy)
  Dep_cur <- getv("Deposits",   curr_fy); Dep_prv <- getv("Deposits",   prev_fy)
  
  tibble(
    Program = wide$Program,
    
    `Inquiry Rate FY{curr_fy}`   = safe_div(P_cur, S_cur),
    `Inquiry Rate Δpp`           = (safe_div(P_cur, S_cur) - safe_div(P_prv, S_prv)) * 100,
    
    # Now Applications are SUBMITS, so this is Submit/Prospect
    `Application Rate FY{curr_fy}` = safe_div(A_cur, P_cur),
    `Application Rate Δpp`         = (safe_div(A_cur, P_cur) - safe_div(A_prv, P_prv)) * 100,
    
    `Admit Rate FY{curr_fy}`     = safe_div(Adm_cur, A_cur),     # admits / submits
    `Admit Rate Δpp`             = (safe_div(Adm_cur, A_cur) - safe_div(Adm_prv, A_prv)) * 100,
    
    `Deposit Rate FY{curr_fy}`   = safe_div(Dep_cur, Adm_cur),
    `Deposit Rate Δpp`           = (safe_div(Dep_cur, Adm_cur) - safe_div(Dep_prv, Adm_prv)) * 100
  )
}

