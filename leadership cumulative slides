# ---- Wilson interval for a proportion (stable, no extra packages) ----
wilson_ci <- function(x, n, z = 1.96) {
  if (n == 0) return(c(NA_real_, NA_real_, NA_real_))
  p <- x / n
  denom <- 1 + (z^2 / n)
  center <- (p + (z^2 / (2*n))) / denom
  half <- (z * sqrt((p*(1-p)/n) + (z^2/(4*n^2)))) / denom
  c(p, max(0, center - half), min(1, center + half))
}

# ---- Forecast deposits from admits using prior-year yield ----
forecast_from_admits <- function(program_vec, curr_fy, prev_fy) {
  out <- lapply(program_vec, function(prg) {
    # current to-date counts
    Adm_cur <- wide %>% filter(Program == prg) %>% pull(paste0("Admits_", curr_fy))
    Dep_cur <- wide %>% filter(Program == prg) %>% pull(paste0("Deposits_", curr_fy))
    
    # prior-year to-date counts (same relative cutoff)
    Adm_prv <- wide %>% filter(Program == prg) %>% pull(paste0("Admits_", prev_fy))
    Dep_prv <- wide %>% filter(Program == prg) %>% pull(paste0("Deposits_", prev_fy))
    
    # prior-year yield estimate + CI
    ci <- wilson_ci(Dep_prv, Adm_prv)
    
    tibble(
      Program = prg,
      Admits_to_date = Adm_cur,
      Deposits_to_date = Dep_cur,
      Yield_prev = ci[1],
      Yield_lo = ci[2],
      Yield_hi = ci[3],
      Deposits_forecast = Adm_cur * ci[1],
      Deposits_forecast_lo = Adm_cur * ci[2],
      Deposits_forecast_hi = Adm_cur * ci[3]
    )
  })
  bind_rows(out)
}

