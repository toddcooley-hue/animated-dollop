events_for_stage <- function(df, stage_name, stage_col, stage_status_col = NA, bad_status_regex = NULL) {
  out <- df %>%
    mutate(StageDate = parse_any_date(.data[[stage_col]])) %>%
    filter(!is.na(StageDate)) %>%
    mutate(Stage = stage_name)
  
  if (!is.na(stage_status_col) && stage_name == "Deposits" && !is.null(bad_status_regex)) {
    out <- out %>% filter(!str_detect(.data[[stage_status_col]] %||% "", bad_status_regex))
