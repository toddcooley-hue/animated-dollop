# ---- Build leadership tables (counts, Δ, %Δ) ----
mk_tbl <- function() {
  stages_in_order <- c("Suspects","Prospects","Applications","Admits","Deposits")
  
  out <- tibble(Program = wide$Program)
  for (stg in stages_in_order) {  # use the same vector here
    cur <- getv(stg, curr_fy); prv <- getv(stg, prev_fy)
    out[[paste0(stg, " FY", curr_fy)]] <- cur
    out[[paste0(stg, " FY", prev_fy)]] <- prv
    out[[paste0(stg, " Δ(FY", curr_fy, "-FY", prev_fy, ")")]] <- cur - prv
    out[[paste0(stg, " %Δ")]] <- ifelse(prv == 0, NA_real_, (cur - prv) / prv)
  }
  
  # use stages_in_order instead of stages
  out <- out %>%
    arrange(
      factor(
        Program,
        levels = c(
          stages_in_order,
          setdiff(sort(unique(Program)), stages_in_order)
        ),
        ordered = TRUE
      )
    )
  
  tot <- out %>%
    summarise(across(where(is.numeric), sum, na.rm = TRUE)) %>%
    mutate(Program = "TOTAL", .before = 1)
  
  for (stg in stages_in_order) {
    cur_total <- tot[[paste0(stg, " FY", curr_fy)]]
    prv_total <- tot[[paste0(stg, " FY", prev_fy)]]
    tot[[paste0(stg, " %Δ")]] <- if (prv_total == 0) NA_real_ else (cur_total - prv_total) / prv_total
  }
  
  bind_rows(out, tot)
}

